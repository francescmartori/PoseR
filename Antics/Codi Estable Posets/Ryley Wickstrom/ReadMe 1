#README#


##Program Description
  This program enables users to:

  - Build Hasse diagrams for partially ordered sets (POSETs).
  - Customize layout orientation (maximal or minimal perspective).
  - Highlight specific chains.
  - Analyze what elements are and are not comparable.
  - Calculate and visualize average heights.
  - Compute antichain matrices for relation insight.
  
  
  - This code currently uses Jitter to space out the points ion the graph, this makes it so that points will not be in the same place as others or in a path connecting 2 other points
    it also means that points on the same level will not line up, they will appear staggered bit still in a relative line, (steps to remove jitter at the end).

  ---



##Usage
  - Run the code like any traditional R Program.
  - Ensure you have the libraries downloaded and the session working directory is set to the folder that contians all the files.
  - You can change the data within the code or import your own data file (explination at the bottom). 
  - When youre running the program, ensure that you provide inputs for the graping perspective (min or max) and the graph title. 
  - Then run the specific plotting types that you want (standard, average heights, highlighted).
  



##Functions
  - get_poset() -----	Computes the poset incidence matrix from input data.
  - antichainMatrix()	----- Generates antichain comparison metrics.
  - plot_poset() --- Wrapper function to plot both standard and average height diagrams.
  - plot_avgheight_poset()	----- Plots poset with nodes placed using average height algorithm.
  - plot_standard_poset()	----- Standard Hasse diagram plot using jitter to avoid overlap.
  - plot_standard_poset_with_chain()	----- Highlights a specific chain within the Hasse diagram.
  - analyze_relations()	----- Outputs related and unrelated elements for each node.
  - find_longest_chain() ----- Finds the longest chain in the diagram either to be highlighted or to count the levels
  - print_number_of_levels() ----- Prints the longest chain and the numebr of levels in the hasse diagram





##Alternate Code
  #Methods Without the Jitter 
    - To use the code without jitter replace these methods (plot_poset and plot_poset_with_chain) in SupportFunctions.R with this code:
  
  
    plot_poset <- function(Z, input = "min", type = c("avgheight", "standard"),
                           method = "approx", color = "white", title = NULL, ...) {
      type <- match.arg(type)
    
      Z.cov <- incidence2cover(Z)
    
      # Get vertices coordinates with orientation depending on input
      V <- if (input == "max") vertices(t(Z.cov)) else -vertices(Z.cov)
    
      if (type == "avgheight") {
        plot_avgheight_poset(Z.cov, Z, V, method, color, title, input)
      } else {
        plot_standard_poset(Z.cov, V, color, title, input)
      }
    }



    plot_standard_poset_with_chain <- function(Z, chain = NULL, title = NULL, input = "min") {
      Z.cov <- incidence2cover(Z)
    
      if (is.null(chain)) {
        stop("Please provide a chain as input.")
      }
    
      V <- if (input == "max") vertices(t(Z.cov)) else -vertices(Z.cov)
    
      xlim <- c(min(V$x), max(V$x)) * 1.3
      ylim <- c(min(V$y), max(V$y)) * 1.1
      main_title <- paste(title, "-highlighted")
    
      plot(V, type = "n", axes = FALSE, xlab = "", ylab = "",
        xlim = xlim, ylim = ylim, asp = 1,
        main = main_title
      )
    
      edge_list <- which(Z.cov == 1, arr.ind = TRUE)
      for (i in seq_len(nrow(edge_list))) {
        from <- edge_list[i, 1]
        to <- edge_list[i, 2]
        from_name <- rownames(Z.cov)[from]
        to_name <- rownames(Z.cov)[to]
    
        pos_from <- match(from_name, chain)
        pos_to <- match(to_name, chain)
    
        is_chain_edge <- !is.na(pos_from) && !is.na(pos_to) && (pos_to - pos_from == 1)
    
        segments(V$x[from], V$y[from], V$x[to], V$y[to],
          col = if (is_chain_edge) "purple" else "gray30",
          lwd = if (is_chain_edge) 3 else 2
        )
      }
    
      node_colors <- ifelse(rownames(Z.cov) %in% chain, "purple", "white")
      points(V$x, V$y, pch = 21, bg = node_colors, cex = 5)
      text(V$x, V$y, labels = rownames(Z.cov), cex = 0.8)
    }



